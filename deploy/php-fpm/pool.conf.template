; WorldCup Universe — dedicated PHP-FPM pool (rendered by scripts/deploy.sh into /etc/php/__PHP_VERSION__/fpm/pool.d/).
; Sized for an Oracle Always Free VM (1 GB AMD or 6–24 GB Ampere); raise pm.max_children on larger shapes.
[worldcup-universe]
user = www-data
group = www-data
listen = /run/php/worldcup-universe-fpm.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660

pm = dynamic
pm.max_children = __MAX_CHILDREN__
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 3
pm.max_requests = 500
request_terminate_timeout = 300s

; Only the front controller may run, and only as PHP.
security.limit_extensions = .php

php_admin_value[upload_max_filesize] = __UPLOAD_MB__M
php_admin_value[post_max_size] = __POST_MB__M
php_admin_value[max_file_uploads] = 10
php_admin_value[memory_limit] = 256M
php_admin_value[max_execution_time] = 300
php_admin_value[max_input_time] = 300
php_admin_flag[display_errors] = off
php_admin_flag[display_startup_errors] = off
php_admin_flag[log_errors] = on
php_admin_value[error_log] = __APP_DIR__/storage/logs/php-fpm-error.log
php_admin_flag[allow_url_include] = off
php_admin_value[session.use_strict_mode] = 1
php_admin_value[date.timezone] = Asia/Shanghai
; The web process never needs to start other programs.
php_admin_value[disable_functions] = exec,passthru,shell_exec,system,proc_open,popen,pcntl_exec
