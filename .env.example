APP_NAME=worldcup-universe
APP_ENV=development
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=Asia/Shanghai

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=worldcup_universe
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

ARK_API_KEY=
ARK_OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=
