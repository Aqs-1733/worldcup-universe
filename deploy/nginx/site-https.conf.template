# WorldCup Universe — HTTPS site with HTTP→HTTPS redirect (rendered by scripts/deploy.sh once the certificate exists).
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name __SERVER_NAME__;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; default_type text/plain; }
    # Always the certificate name: a visitor typing the bare IP would otherwise land on a name mismatch.
    location / { return 301 https://__SERVER_NAME__$request_uri; }
}

server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name __SERVER_NAME__;
    set $wcu_hsts "max-age=31536000";

    ssl_certificate     /etc/letsencrypt/live/__CERT_NAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CERT_NAME__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:wcu_ssl:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/snippets/worldcup-universe-app.conf;
}
