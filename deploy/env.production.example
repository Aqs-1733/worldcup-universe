# WorldCup Universe — production .env template (Oracle Cloud Ubuntu + Nginx + PHP-FPM + MySQL 8).
# scripts/deploy.sh copies this to .env on first run and fills every value marked "generated".
# Never commit the resulting .env. File mode should be 640, owner <deploy user>:www-data.

APP_NAME=worldcup-universe
APP_ENV=production
# https://<your domain> once TLS is issued; http://<public IP> only for a first smoke test.
APP_URL=https://example.com
APP_TIMEZONE=Asia/Shanghai
# 1 forces Secure cookies, 0 disables them; empty = Secure when APP_ENV=production and APP_URL is https://.
SESSION_SECURE_COOKIE=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=worldcup_universe
DB_USERNAME=wcu_app
# generated
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_SCHEMA_CACHE=1

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# generated on first deploy (only used to create the administrator once; the stored hash never changes afterwards)
ADMIN_PASSWORD=

# generated: 64 hex characters; keep it stable across deployments so sessions survive
YII_COOKIE_VALIDATION_KEY=

# Upload limits in MB. PHP-FPM post_max_size and the Nginx body limit of /admin/ are derived from the largest;
# every other route stays at 16 MB.
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_VIDEO_MB=200
UPLOAD_MAX_DOCUMENT_MB=100

# Optional AI features; leave empty to keep them disabled.
ARK_API_KEY=
ARK_OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=
ARK_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=
ARK_IMAGE_SIZE=1024x1024
ARK_IMAGE_RESPONSE_FORMAT=url
ARK_DNS_FALLBACK_IP=

SYNC_USER_AGENT=worldcup-universe/1.0 (+https://github.com/Aqs-1733/worldcup-universe)
NEWS_MAX_PER_SOURCE=24
NEWS_RSS_TIMEOUT=5
NEWS_ARTICLE_TIMEOUT=2
NEWS_TRANSLATE_TIMEOUT=6
NEWS_ARK_TRANSLATE_TIMEOUT=30
NEWS_TRANSLATION_PROVIDER=auto
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost,::1

FIFA_TEAMS_URL=https://www.fifa.com/en/tournaments/mens/worldcup/canadamexicousa2026/teams
FIFA_FIXTURES_URL=https://www.fifa.com/en/tournaments/mens/worldcup/canadamexicousa2026/scores-fixtures
FIFA_STANDINGS_URL=https://www.fifa.com/en/tournaments/mens/worldcup/canadamexicousa2026/standings
FIFA_COMPETITION_ID=17
FIFA_SEASON_ID=285023
NEWS_POLL_INTERVAL=300
